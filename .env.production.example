# SagraFlow in production. Copy this next to compose.prod.yaml as ".env", fill in
# the one empty line, and set the address the tablets will type.

# The tag to run. Change it and `docker compose up -d` to move version, or to go
# back to the one that worked.
SAGRAFLOW_TAG=v0.1.1

APP_NAME=SagraFlow
APP_ENV=production
APP_DEBUG=false

# Generated once, from the image itself:
#   docker run --rm ghcr.io/sagraflow/sagraflow:v0.1.1 php artisan key:generate --show
# Keep it: change it and everything encrypted with the old one is unreadable.
APP_KEY=

# The address the tablets type. The machine's address on the hall's network, not
# localhost - the tills are other devices.
APP_URL=http://192.168.1.10

# Straight to the container's output, so `docker compose logs -f app` is the log
# and no file grows quietly inside a container.
LOG_CHANNEL=stderr
LOG_LEVEL=warning

# The service names of the compose file.
DB_CONNECTION=pgsql
DB_HOST=pgsql
DB_PORT=5432
DB_DATABASE=sagraflow
DB_USERNAME=sagraflow
DB_PASSWORD=sagraflow

REDIS_CLIENT=phpredis
REDIS_HOST=valkey
REDIS_PORT=6379

SESSION_DRIVER=database
# Two hours of inactivity. The tills refresh it at every touch, so this is about
# the afternoon in between, not about service.
SESSION_LIFETIME=120

CACHE_STORE=database
QUEUE_CONNECTION=redis

# The till's own port on the machine. 80 means the tablets need no port at all.
APP_PORT=80
